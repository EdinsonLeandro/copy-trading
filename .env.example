# --- Broker-agnostic settings (src/common/config.py) ---

# Playwright Settings
# Set to False to watch the browser actions in real-time (recommended during development)
HEADLESS=False

# Randomized delay range between actions (in milliseconds) to avoid bot detection
MIN_DELAY_MS=300
MAX_DELAY_MS=800

# Set to True to save a screenshot + HTML dump to debug/<broker>/ for every
# profile whose expected data comes back empty (useful for diagnosing extractor
# bugs; noisy otherwise, so off by default)
DEBUG_SNAPSHOTS=False

# --- FP Markets credentials (src/brokers/fpmarkets/config.py) ---
FPMARKETS_EMAIL=your_email@example.com
FPMARKETS_PASSWORD=your_secure_password
FPMARKETS_PIN=your_account_pin

# --- Binance credentials (src/brokers/binance/config.py) ---
BINANCE_EMAIL=your_email@example.com
BINANCE_PASSWORD=your_secure_password
