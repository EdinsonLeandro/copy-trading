# FP Markets Credentials
FPMARKETS_EMAIL=your_email@example.com
FPMARKETS_PASSWORD=your_secure_password
FPMARKETS_PIN=your_account_pin

# Playwright Settings
# Set to False to watch the browser actions in real-time (recommended during development)
HEADLESS=False

# Randomized delay range between actions (in milliseconds) to avoid bot detection
MIN_DELAY_MS=300
MAX_DELAY_MS=800
